{
  "name": "polidesk",
  "version": "0.1.0",
  "description": "Registrazioni, appunti, calendario e strumenti di studio per gli studenti del Politecnico di Milano (app non ufficiale)",
  "main": "src/main.js",
  "license": "GPL-3.0-or-later",
  "repository": "github:tommaso-dognini/polidesk",
  "homepage": "https://github.com/tommaso-dognini/polidesk",
  "bugs": "https://github.com/tommaso-dognini/polidesk/issues",
  "scripts": {
    "start": "electron .",
    "cli": "cargo run -q --release -p polidesk --",
    "dist": "electron-builder",
    "dist:mac": "electron-builder --mac",
    "dist:win": "electron-builder --win",
    "dist:linux": "electron-builder --linux",
    "build:editor": "esbuild src/renderer-src/editor.js --bundle --minify --format=iife --outfile=src/renderer/vendor/editor.js",
    "prestart": "npm run build:editor && cargo build -p polidesk -p polideskd",
    "predist": "npm run build:editor && node scripts/build-rust.js",
    "predist:mac": "npm run predist",
    "predist:win": "npm run predist",
    "predist:linux": "npm run predist",
    "mcp": "cargo run -q --release -p polidesk -- mcp",
    "build:rust": "cargo build --release",
    "daemon": "cargo run --release -p polideskd"
  },
  "dependencies": {
    "@fontsource/jetbrains-mono": "^5.3.0",
    "ffmpeg-static": "^5.3.0",
    "hls.js": "1.6.15",
    "leaflet": "1.9"
  },
  "devDependencies": {
    "@codemirror/autocomplete": "^6.20.4",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.13.1",
    "@codemirror/legacy-modes": "^6.5.5",
    "@codemirror/merge": "^6.12.3",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@lezer/highlight": "^1.2.5",
    "@mdit/plugin-katex-slim": "^0.26.2",
    "codemirror": "^6.0.2",
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.25.12",
    "katex": "^0.16.47",
    "markdown-it": "^14.3.3"
  },
  "author": "Tommaso Dognini",
  "build": {
    "afterPack": "scripts/check-bundle.js",
    "appId": "it.polidesk.app",
    "productName": "PoliDesk",
    "copyright": "GPL-3.0-or-later — PoliDesk contributors, built on PoliWebex (sup3rgiu) and the PoliNetwork community",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "python/**/*",
      "package.json",
      "LICENSE",
      "NOTICE.md",
      "PRIVACY.md",
      "!**/*.map",
      "!src/renderer-src/**"
    ],
    "asarUnpack": [
      "python/**",
      "node_modules/ffmpeg-static/**"
    ],
    "mac": {
      "category": "public.app-category.education",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "identity": null,
      "extendInfo": {
        "NSMicrophoneUsageDescription": "PoliDesk usa il microfono solo per la dettatura negli appunti (trascritta in locale).",
      "NSCalendarsUsageDescription": "PoliDesk mostra nel suo calendario gli eventi dei calendari che scegli (iCloud, Google, Exchange del Politecnico). Non li modifica e non li invia a nessuno.",
      "NSCalendarsFullAccessUsageDescription": "PoliDesk mostra nel suo calendario gli eventi dei calendari che scegli (iCloud, Google, Exchange del Politecnico). Non li modifica e non li invia a nessuno."
      },
      "icon": "build/icon.png"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "linux": {
      "category": "Education",
      "maintainer": "Tommaso Dognini <tommaso-dognini@users.noreply.github.com>",
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "build/icon.png"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "tommaso-dognini",
        "repo": "polidesk",
        "releaseType": "release"
      }
    ],
    "extraResources": [
      {
        "from": "target/dist-bin",
        "to": "bin",
        "filter": [
          "polideskd*",
          "polidesk",
          "polidesk.exe"
        ]
      }
    ]
  },
  "polidesk": {
    "donateUrl": "",
    "repo": "tommaso-dognini/polidesk"
  }
}
